   "source": [
    "# 4. Convert Checkin_Date to datetime and extract month and weekday\n",
    "\n",
    "# Convert date column\n",
    "df['Checkin_Date'] = pd.to_datetime(\n",
    "    df['Checkin_Date'],\n",
    "    errors='coerce'\n",
    ")\n",
    "\n",
    "# Extract arrival month\n",
    "df['Arrival_Month'] = df['Checkin_Date'].dt.month_name()\n",
    "\n",
    "# Extract arrival weekday\n",
    "df['Arrival_Weekday'] = df['Checkin_Date'].dt.day_name()\n",
    "\n",
    "# Display results\n",
    "print(df[['Checkin_Date', 'Arrival_Month', 'Arrival_Weekday']].head())"
   ]
