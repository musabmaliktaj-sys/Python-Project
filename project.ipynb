   "source": [
    "# 9. Cancellation analysis by booking channel and lead-time bands\n",
    "\n",
    "# Create lead-time bands\n",
    "df['Lead_Time_Band'] = pd.cut(\n",
    "    df['Lead_Time_Days'],\n",
    "    bins=[-1, 7, 30, 179],\n",
    "    labels=['Last-Minute', 'Short-Term', 'Advance']\n",
    ")\n",
    "\n",
    "# Create cancellation indicator\n",
    "df['Cancellation_Flag'] = (\n",
    "    df['Canceled'].str.strip().str.lower() == 'yes'\n",
    ").astype(int)\n",
    "\n",
    "# Cancellation rate by booking channel\n",
    "channel_cancellation = df.groupby('Booking_Channel').agg(\n",
    "    Total_Bookings=('Booking_ID', 'count'),\n",
    "    Cancelled_Bookings=('Cancellation_Flag', 'sum')\n",
    ")\n",
    "\n",
    "channel_cancellation['Cancellation_Rate_Percentage'] = (\n",
    "    channel_cancellation['Cancelled_Bookings'] /\n",
    "    channel_cancellation['Total_Bookings'] * 100\n",
    ")\n",
    "\n",
    "print(\"Cancellation Rate by Booking Channel:\")\n",
    "print(channel_cancellation.round(2))\n",
    "\n",
    "# Cancellation rate by lead-time band\n",
    "lead_cancellation = df.groupby('Lead_Time_Band', observed=False).agg(\n",
    "    Total_Bookings=('Booking_ID', 'count'),\n",
    "    Cancelled_Bookings=('Cancellation_Flag', 'sum')\n",
    ")\n",
    "\n",
    "lead_cancellation['Cancellation_Rate_Percentage'] = (\n",
    "    lead_cancellation['Cancelled_Bookings'] /\n",
    "    lead_cancellation['Total_Bookings'] * 100\n",
    ")\n",
    "\n",
    "print(\"\\nCancellation Rate by Lead-Time Band:\")\n",
    "print(lead_cancellation.round(2))\n",
    "\n",
    "# Cancellation rate by channel AND lead-time band\n",
    "channel_lead_cancellation = df.pivot_table(\n",
    "    index='Booking_Channel',\n",
    "    columns='Lead_Time_Band',\n",
    "    values='Cancellation_Flag',\n",
    "    aggfunc='mean',\n",
    "    observed=False\n",
    ") * 100\n",
    "\n",
    "print(\"\\nCancellation Rate by Channel and Lead-Time Band:\")\n",
    "print(channel_lead_cancellation.round(2))"
   ]
