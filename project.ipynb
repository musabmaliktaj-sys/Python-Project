    "# 13. Identify unusually high booking revenue using IQR\n",
    "\n",
    "# Consider only non-cancelled bookings\n",
    "valid_revenue = df.loc[\n",
    "    df['Canceled'].str.strip().str.lower() == 'no',\n",
    "    'Realized_Revenue'\n",
    "]\n",
    "\n",
    "# Calculate quartiles\n",
    "Q1 = np.percentile(valid_revenue, 25)\n",
    "Q3 = np.percentile(valid_revenue, 75)\n",
    "\n",
    "# Calculate IQR\n",
    "IQR = Q3 - Q1\n",
    "\n",
    "# Calculate upper limit\n",
    "upper_limit = Q3 + 1.5 * IQR\n",
    "\n",
    "# Identify high revenue outliers\n",
    "high_value_bookings = df[\n",
    "    (df['Canceled'].str.strip().str.lower() == 'no') &\n",
    "    (df['Realized_Revenue'] > upper_limit)\n",
    "]\n",
    "\n",
    "# Display results\n",
    "print(\"Q1:\", round(Q1, 2))\n",
    "print(\"Q3:\", round(Q3, 2))\n",
    "print(\"IQR:\", round(IQR, 2))\n",
    "print(\"Upper Limit:\", round(upper_limit, 2))\n",
    "\n",
    "print(\"\\nHigh-Value Bookings:\")\n",
    "print(high_value_bookings[\n",
    "    ['Booking_ID', 'Room_Type', 'Nights',\n",
    "     'Room_Rate', 'Realized_Revenue']\n",
    "])\n",
    "\n",
    "print(\"\\nNumber of High-Value Bookings:\", len(high_value_bookings))"
