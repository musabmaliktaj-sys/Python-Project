    "# 3. Handle missing values\n",
    "\n",
    "# Fill missing Lead_Time_Days with median\n",
    "df['Lead_Time_Days'] = df['Lead_Time_Days'].fillna(\n",
    "    df['Lead_Time_Days'].median()\n",
    ")\n",
    "\n",
    "# Fill missing Room_Rate with median\n",
    "df['Room_Rate'] = df['Room_Rate'].fillna(\n",
    "    df['Room_Rate'].median()\n",
    ")\n",
    "\n",
    "# Check missing values after filling\n",
    "print(\"Missing values after handling:\")\n",
    "print(df[['Lead_Time_Days', 'Room_Rate']].isnull().sum())\n",
    "\n",
    "# Display updated data\n",
    "print(\"\\nUpdated Dataset:\")\n",
    "print(df.head())"
