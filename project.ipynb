   "source": [
    "# 6. Calculate booking revenue\n",
    "\n",
    "# Calculate revenue for each booking\n",
    "df['Revenue'] = df['Nights'] * df['Room_Rate']\n",
    "\n",
    "# Calculate realized revenue\n",
    "# Cancelled bookings will have zero realized revenue\n",
    "df['Realized_Revenue'] = np.where(\n",
    "    df['Canceled'].str.strip().str.lower() == 'yes',\n",
    "    0,\n",
    "    df['Revenue']\n",
    ")\n",
    "\n",
    "# Display revenue columns\n",
    "print(df[['Booking_ID', 'Nights', 'Room_Rate',\n",
    "           'Canceled', 'Revenue', 'Realized_Revenue']].head(10))\n",
    "\n",
    "# Total realized revenue\n",
    "total_revenue = df['Realized_Revenue'].sum()\n",
    "\n",
    "print(\"\\nTotal Realized Revenue:\", round(total_revenue, 2))"
   ]
  },
