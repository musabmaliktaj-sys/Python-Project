   "source": [
    "# 5. Calculate total bookings, total room nights, and cancellation percentage\n",
    "\n",
    "# Total bookings\n",
    "total_bookings = df['Booking_ID'].count()\n",
    "\n",
    "# Total room nights\n",
    "total_room_nights = df['Nights'].sum()\n",
    "\n",
    "# Count cancelled bookings\n",
    "cancelled_bookings = df['Canceled'].str.strip().str.lower().eq('yes').sum()\n",
    "\n",
    "# Calculate cancellation percentage\n",
    "cancellation_percentage = (cancelled_bookings / total_bookings) * 100\n",
    "\n",
    "# Display results\n",
    "print(\"Total Bookings:\", total_bookings)\n",
    "print(\"Total Room Nights:\", total_room_nights)\n",
    "print(\"Cancelled Bookings:\", cancelled_bookings)\n",
    "print(\"Cancellation Percentage:\", round(cancellation_percentage, 2), \"%\")"
   ]
  },
